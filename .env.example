# Export these variables in your shell; this file is documentation, not auto-loaded.
FORECASTLAB_DATA_DIR=data
# SQLite is the default. To use an existing PostgreSQL server:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/forecastlab
